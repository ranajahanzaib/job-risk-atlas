{
  "name": "job-risk-atlas",
  "version": "0.1.0",
  "private": true,
  "description": "An evidence-led atlas of occupational requirements and fatal work injuries.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"pnpm api\" \"vite --config vite.config.ts\"",
    "dev:web": "vite --config vite.config.ts",
    "api": "python3 server.py",
    "build": "tsc --noEmit && vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts --host 127.0.0.1",
    "test": "python3 -m unittest discover -s tests"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.6.3",
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "lucide-react": "^1.79.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.11.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
